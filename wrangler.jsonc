{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "securecompare",
  "main": "src/worker/index.mjs",
  "compatibility_date": "2026-06-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws*", "/api/*", "/leaderboard*", "/healthz"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "INVITE_ROOMS",
        "class_name": "InviteRoom"
      },
      {
        "name": "LEADERBOARDS",
        "class_name": "LeaderboardBoard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["InviteRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["LeaderboardBoard"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
